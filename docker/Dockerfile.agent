FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake g++ git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
RUN pip install --no-cache-dir pybind11 numpy sentence-transformers ollama pydantic pytest matplotlib

COPY . .

RUN cmake -S parser -B parser/build -DCMAKE_BUILD_TYPE=Release -DCELLTRACE_BUILD_TESTS=OFF -DCELLTRACE_BUILD_BENCH=OFF \
    && cmake --build parser/build -j "$(nproc)"

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["python", "-m", "eval.run_eval"]
